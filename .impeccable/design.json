      "html": "<button class=\"ds-atlas-node\" type=\"button\" aria-pressed=\"false\" aria-label=\"探索当前处境\"><span class=\"ds-node-orb\"></span><span class=\"ds-atlas-name\">当下</span></button>",
      "css": ".ds-atlas-node{position:relative;width:84px;height:88px;background:transparent;border:0;border-radius:50%;color:#c1d9cf;cursor:pointer}.ds-node-orb{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:28px;height:28px;border-radius:50%;background:radial-gradient(circle at 28% 25%,#f0f9e9,#a1b8b0 24%,#3b5653 58%,#071917 83%);box-shadow:inset -3px -2px 5px #061314a0,0 0 16px #a2d0b825;border:1px solid #d8edda35}.ds-atlas-name{position:absolute;top:calc(50% + 24px);left:50%;transform:translateX(-50%);white-space:nowrap;font-size:16px}.ds-atlas-node:hover .ds-node-orb{transform:translate(-50%,-50%) scale(1.16)}.ds-atlas-node:focus-visible{outline:2px solid #b9f4ce;outline-offset:6px}"
    },
    {
