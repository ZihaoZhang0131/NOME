  "narrative": {
    "northStar": "个人星图",
    "overview": "深墨绿空间里，六个领域围绕同一个人展开。薄荷色轨道、网格球体和等大的发光节点形成识别语言；星图承担领域选择，不表达人格评分或完成度。\n\n阅读界面延续同一暗色空间，以温白正文、细分隔线和留白承载个人记录。界面只读；确认、待核实、草稿和主动留白有各自明确的文字表达。原生 SVG 与本地字体构成视觉材料，运行时不依赖外部资源。",
    "keyCharacteristics": [
      "深墨绿底色与薄荷色光感。",
      "主星球、六颗卫星和共同的椭圆公转轨道。",
      "阅读内容用分栏与横线组织，状态同时用文字说明。",
      "缓慢自转、小幅视差和节点镜头推进；支持暂停和减少动态效果。"
    ],
    "rules": [
      {
        "name": "The Explicit State Rule",
        "body": "颜色辅助区分状态，阅读视图必须保留“已确认”“待核实”“草稿”等文字。",
        "section": "colors"
      },
      {
        "name": "The Local Display Rule",
        "body": "展示字库是固定标题子集，新增展示文案前须核对字形覆盖；用户正文继续使用完整的中文文本字体栈。",
        "section": "typography"
      },
      {
        "name": "The Orbital Light Rule",
        "body": "光晕服务于星图节点与球体；记录阅读依靠色层、间距和分隔线建立结构。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 保留等大的领域节点，用文字与状态色表达记录性质。",
      "**Do** 保持星图的 SVG 几何材质与局部发光，阅读内容使用清晰的正文和分隔线。",
      "**Do** 为所有可操作元素保留键盘焦点与足够的命中区域，并尊重减少动态效果设置。",
      "**Do** 从本地提供字体和图形资源，扩展展示文案时检查字体子集。"
    ],
    "donts": [
      "**Don't** 把节点大小、轨道或亮度解释为人格评分、完成度或能力排名。",
      "**Don't** 在当前首页恢复顶部导航、描述、内容卡片、英文标语或底部引导区。",
      "**Don't** 只靠颜色区分已确认、待核实、草稿和主动留白。",
      "**Don't** 把虚构示例资料当成用户真实档案展示。"
    ]
  }
}
